# Copie para .env e altere credenciais/segredo. Exemplos apenas para desenvolvimento local.
MYSQL_DATABASE=comanda_digital
MYSQL_USER=comanda_app
MYSQL_PASSWORD=altere_esta_senha_local
MYSQL_ROOT_PASSWORD=altere_esta_senha_root_local
# Gere uma chave aleatória antes de iniciar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=SUBSTITUA_POR_CHAVE_BASE64_ALEATORIA_DE_32_BYTES
JWT_EXPIRATION_MS=28800000

# URLs e portas publicadas pelo Compose local.
FRONTEND_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:8080/api
FRONTEND_PORT=4200
API_PORT=8080
MYSQL_PORT=3306

# Use as variáveis DB_* ao executar o backend diretamente no host.
DB_URL=jdbc:mysql://localhost:3306/comanda_digital?serverTimezone=America/Sao_Paulo
DB_USERNAME=comanda_app
DB_PASSWORD=altere_esta_senha_local
